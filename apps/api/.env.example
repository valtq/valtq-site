# Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Supabase Postgres — Transaction-mode pooler (app runtime, port 6543)
# From: Supabase → Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Postgres — Direct connection (Prisma migrations, port 5432)
# Same string but port 5432 and no ?pgbouncer=true
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# CORS — comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute

# Resend (email notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ValtQ <noreply@valtq.com>

# Cal.com
CAL_API_KEY=
CAL_WEBHOOK_SECRET=

# Internal team notification recipient
INTERNAL_NOTIFICATION_EMAIL=team@valtq.com
