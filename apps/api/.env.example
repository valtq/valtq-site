# Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# SQLite (local) — switch to Postgres connection string in production
DATABASE_URL="file:./dev.db"

# CORS — comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:3000

# Secret for verifying incoming Cal.com webhooks
CAL_WEBHOOK_SECRET=your_cal_webhook_secret_here
# (Optional) Internal lead notification channel
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute

# Resend (email notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ValtQ <noreply@valtq.com>

# Cal.com
CAL_API_KEY=

# Internal team notification recipient
INTERNAL_NOTIFICATION_EMAIL=team@valtq.com
