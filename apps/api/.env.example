# SQLite file path (MVP) / Postgres connection string (later)
DATABASE_URL="file:./dev.db"

# Resend API key for transactional email
RESEND_API_KEY=re_your_key_here

# Secret for verifying incoming Cal.com webhooks
CAL_WEBHOOK_SECRET=your_cal_webhook_secret_here

# (Optional) Internal lead notification channel
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# API server port
PORT=4000
