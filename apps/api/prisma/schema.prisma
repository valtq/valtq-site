generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  phone       String?
  country     String?
  website     String?
  projectType String   @map("project_type")
  budget      String
  timeline    String
  description String
  features    String? // JSON array stored as string
  answers     String? // JSON object for extended discovery answers
  score       Int      @default(0)
  status      String   @default("new")
  booked      Boolean  @default(false)
  bookingId   String?  @map("booking_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bookings         Booking[]
  notificationLogs NotificationLog[]

  @@index([email])
  @@index([status])
  @@map("leads")
}

model Booking {
  id           String   @id @default(cuid())
  leadId       String   @map("lead_id")
  calBookingId String   @unique @map("cal_booking_id")
  eventType    String   @map("event_type")
  startsAt     DateTime @map("starts_at")
  endsAt       DateTime @map("ends_at")
  createdAt    DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("bookings")
}

model ContactInquiry {
  id               String   @id @default(cuid())
  name             String
  email            String
  company          String?
  phone            String?
  preferredChannel String?  @map("preferred_channel")
  serviceArea      String?  @map("service_area")
  productStage     String?  @map("product_stage")
  productUrl       String?  @map("product_url")
  timing           String?
  budget           String?
  summary          String
  message          String
  status           String   @default("new")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  notificationLogs NotificationLog[]

  @@index([email])
  @@index([status])
  @@map("contact_inquiries")
}

model NotificationLog {
  id        String   @id @default(cuid())
  leadId    String?  @map("lead_id")
  contactId String?  @map("contact_id")
  type      String
  provider  String
  success   Boolean
  metadata  String? // JSON object
  createdAt DateTime @default(now()) @map("created_at")

  lead    Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact ContactInquiry? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([contactId])
  @@index([type])
  @@map("notification_logs")
}
