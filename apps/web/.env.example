# Base URL of the backend API
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cal.com booking link/event slug
NEXT_PUBLIC_CAL_LINK=your-cal-link

# ── Portfolio admin (MongoDB + Auth.js) ─────────────────────────────
# Never commit real values. Copy to .env / .env.local locally and on Vercel.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/valtq?appName=Cluster0

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string
AUTH_TRUST_HOST=true

# Single admin account (temporary; rotate after first login)
ADMIN_EMAIL=admin@valtq.net
ADMIN_PASSWORD=change-me
